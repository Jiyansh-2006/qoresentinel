{
  "name": "@qoresentinel/api",
  "version": "1.0.0",
  "description": "Backend API and Autonomous AI Agent System for QoreSentinel",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate --schema=../../prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=../../prisma/schema.prisma",
    "seed": "tsx src/services/seed.ts",
    "test": "node --test --test-concurrency=1 dist/test/advisoryNarrative.test.js dist/test/agentRoutes.test.js dist/test/assistantRoutes.test.js dist/test/authRoutes.test.js dist/test/dashboard.test.js dist/test/grantReceiptVerifier.test.js dist/test/integration.test.js dist/test/securityRoutes.test.js"
  },
  "dependencies": {
    "@cosmjs/encoding": "^0.39.0",
    "@cosmjs/stargate": "^0.39.0",
    "@noble/hashes": "^1.4.0",
    "@noble/post-quantum": "^0.2.0",
    "@prisma/client": "^5.14.0",
    "@qorechain/pqc": "^0.2.3",
    "@qorechain/sdk": "^0.14.0",
    "@qoresentinel/crypto": "*",
    "@qoresentinel/shared": "*",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "express": "^4.19.2",
    "viem": "^2.58.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "prisma": "^5.14.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  }
}
