# Copy this file to .env and replace any values needed for your environment.
# Never commit .env or real credentials.

# Runtime SQLite database for accounts, applications, pools, decisions, audit logs, and ledgers.
DATABASE_PATH="./data/qoresentinel.sqlite"
# Optional Prisma tooling database; the API currently uses better-sqlite3 via DATABASE_PATH.
DATABASE_URL="file:./prisma/dev.db"

# Authentication
ADMIN_INVITATION_CODE=""
APP_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
COOKIE_SECURE="false"

# Optional assistant explanations and website guide
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# QoreChain Diana Testnet
QORECHAIN_NATIVE_RPC="https://rpc-testnet.qore.host"
QORECHAIN_REST_URL="https://api-testnet.qore.host"
QORECHAIN_EVM_RPC="https://evm-testnet.qore.host"
QORECHAIN_SVM_RPC="https://svm-testnet.qore.host"
QORECHAIN_CHAIN_ID="9800"
QORECHAIN_NATIVE_CHAIN_ID="qorechain-diana"
QORECHAIN_NETWORK="diana-testnet"
QORECHAIN_EXPLORER_URL="https://explore.qore.network"
QORECHAIN_CONTRACT_ADDRESS=""

# Required only for deployment scripts or the agent-key rotation endpoint.
# Generate private values locally; use a secret manager in deployed environments.
QORECHAIN_PRIVATE_KEY=""
QORECHAIN_AGENT_PRIVATE_KEY=""
MLDSA_KEY_ENCRYPTION_SECRET=""

# Optional storage integrations
IPFS_API_URL="https://ipfs.io/ipfs/"
IPFS_API_KEY=""

# App settings
DEMO_MODE="true"
PORT="4000"
VITE_API_URL="http://localhost:4000"
VITE_WALLETCONNECT_PROJECT_ID=""
